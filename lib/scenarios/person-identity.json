      "response_status": 401,
      "response_headers": {
        "AAuth-Requirement": "requirement=auth-token; resource-token=\"eyJhbGciOiJFZERTQSIsImtpZCI6InJlc291cmNlLWtleS0xIiwidHlw…\""
      },
      "response_body": null,
      "tokens": [
        {
          "name": "Resource Token",
          "typ": "aa-resource+jwt",
          "raw": "eyJhbGciOiJFZERTQSIsImtpZCI6InJlc291cmNlLWtleS0xIiwidHlwIjoiYWEtcmVzb3VyY2Urand0In0..6QznE3sOp9JX6RY4a0olsuHZSIKAn5t4HwyxK9M8fOOIW9D2nQGR18uObb97Ui6BZdb0F8gTP7BqI5BO0WRsDA",
          "header": {
