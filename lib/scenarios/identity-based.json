{
  "id": "identity-based",
  "title": "Agent Identity Access",
  "description": "The agent signs requests with its agent token. The resource verifies the HTTP signature and the token, and applies its own access control policy on who the agent is. This replaces API keys with cryptographic identity: no authorization flow, no PS, no AS, and no token beyond the agent token. A resource that wants an AAuth agent token in particular says so with requirement=agent-token.",
  "spec_section": "§ Agent Identity Access",
  "category": "access",
  "demo_phase": null,
  "participants": [
    {
      "id": "agent",
      "label": "Agent",
      "type": "agent"
    },
    {
      "id": "resource",
      "label": "Resource",
      "type": "resource"
    }
  ],
  "steps": [
    {
      "step": 1,
      "from": "agent",
      "to": "resource",
      "label": "Signed GET /data (sig=jwt) → resource verifies agent token → 200",
      "method": "GET",
      "url": "https://api.example/data",
      "request_headers": {
        "Host": "api.example",
        "Signature-Key": "sig=jwt;jwt=\"eyJhbGciOiJFZERTQSIsImtpZCI6ImFnZW50LWtleS0xIiwidHlwIjoiYWEtYWdlbnQrand0In0…\"",
        "Signature-Input": "sig=(\"@method\" \"@authority\" \"@path\" \"signature-key\");created=1700000000;alg=\"ed25519\"",
        "Signature": "sig=:BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQ:"
      },
      "request_body": null,
