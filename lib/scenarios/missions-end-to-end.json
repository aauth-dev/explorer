{
  "id": "missions-end-to-end",
  "title": "Full Mission Lifecycle (End-to-End)",
  "description": "The complete mission lifecycle in a four-party deployment, from PS discovery to resource access. The mission is approved with a person token attached for the resource it named; the agent presents that person token at the resource's authorization endpoint; mission_s256 flows person token → resource token → auth token, one digest the whole way.",
  "spec_section": "§ Mission Lifecycle",
  "category": "missions",
  "demo_phase": 12,
