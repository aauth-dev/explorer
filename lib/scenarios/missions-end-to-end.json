          "step": 7,
          "participant": "agent",
          "label": "Presented to the resource",
          "kind": "presented"
        }
      ]
    }
  ],
  "deferred_timeline": {
    "title": "Mission Approval Timeline",
    "events": [
      {
        "step": 2,
        "status": 202,
        "label": "Proposal submitted",
        "detail": "PS queues mission for user review, returns pending + interaction URLs"
      },
      {
        "step": 3,
        "status": 200,
        "label": "User approves",
        "detail": "User reviews mission description and tool list at the interaction URL"
      },
      {
        "step": 4,
        "status": 200,
        "label": "Mission approved",
        "detail": "Agent polls pending URL — PS returns {s256, mission, capabilities, person_tokens}"
      },
      {
        "step": 7,
        "status": 200,
        "label": "Resource access granted",
        "detail": "Resource verifies s256 chain end-to-end, grants access"
      }
    ]
  },
