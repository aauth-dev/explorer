{
  "id": "missions-resource-access",
  "title": "Mission Context at a Resource",
  "description": "How a mission reaches a resource in -11: the agent names the mission when it asks its PS for a person token, the PS stamps mission_s256 into that token, the resource copies it into the resource token it issues, and the issuer copies it into the auth token. There is no AAuth-Mission header — the mission is never agent-asserted, and a resource reads it only from a PS-issued token.",
  "spec_section": "§ Mission Context at Resources",
  "category": "missions",
  "demo_phase": 10,
