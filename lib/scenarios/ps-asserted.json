{
  "id": "ps-asserted",
  "title": "PS Authorization Access (3-party)",
  "description": "The resource has no access server. The agent first obtains a person token from its PS, presents it at the resource's authorization endpoint, and gets back a resource token whose aud is the PS URL. The PS resolves the person token the resource token names, applies the person's consent, and issues the auth token itself. The auth token's iss is the PS, and the resource applies its own policy to the claims it asserts.",
  "spec_section": "§ PS Authorization Access (Three-Party)",
  "category": "access",
  "demo_phase": 3,
  "participants": [
    {
      "id": "agent",
      "label": "Agent",
      "type": "agent"
    },
    {
      "id": "resource",
      "label": "Resource",
      "type": "resource"
    },
    {
      "id": "ps",
      "label": "Person Server",
      "type": "person-server"
    }
  ],
  "steps": [
