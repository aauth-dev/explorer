    "deferred_timeline": {
      "title": "PS Deferred Authorization Polling",
      "events": [
        {
          "step": 3,
          "status": 202,
          "label": "Initial deferred response",
          "detail": "PS needs user approval; returns pending and interaction URLs."
        },
        {
          "step": 4,
          "status": 202,
          "label": "First poll",
          "detail": "User has not approved yet; keep polling."
        },
        {
          "step": 6,
          "status": 202,
          "label": "Poll — interacting",
          "detail": "User has arrived at the consent page; status=interacting. Agent stops prompting."
        },
        {
          "step": 7,
          "status": 200,
          "label": "Approved",
          "detail": "After consent, the next poll returns the PS-issued auth token."
        }
      ]
    },
