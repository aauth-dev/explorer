          },
          "signature_b64": "8byvGd-PR3uOLeS_HYOpbW7OD_8whUuDRnadQOL83-3jp5V_zwPUkKvBZ-WmB26EaWGey4bVktpWtpykEOy_Bw"
        }
      ],
      "signature": {
        "scheme": "jwt",
        "signature_base": "\"@method\": GET\n\"@authority\": api.example\n\"@path\": /data\n\"authorization\": AAuth rm-tok-a8f3c2e1b94d7065f2a1\n\"signature-key\": sig=jwt;jwt=\"eyJhbGciOiJFZERTQSIsImtpZCI6ImFnZW50LWtleS0xIiwidHlwIjoiYWEtYWdlbnQrand0In0…\"\n\"@signature-params\": (\"@method\" \"@authority\" \"@path\" \"authorization\" \"signature-key\");created=1700000000;alg=\"ed25519\"",
        "signature_input": "sig=(\"@method\" \"@authority\" \"@path\" \"authorization\" \"signature-key\");created=1700000000;alg=\"ed25519\"",
        "signature_key": "sig=jwt;jwt=\"eyJhbGciOiJFZERTQSIsImtpZCI6ImFnZW50LWtleS0xIiwidHlwIjoiYWEtYWdlbnQrand0In0…\"",
        "covered_components": [
          "@method",
          "@authority",
          "@path",
          "authorization",
          "signature-key"
        ]
      },
      "annotations": [
        "Agent presents the session token via Authorization: AAuth <token>.",
        "Agent MUST include 'authorization' in the HTTP signature covered components — this binds the session token to the signed request.",
        "Without the signature binding, the session token could be stolen and replayed as a standalone bearer token. The resource MAY return a new AAuth-Access value on any response, which the agent MUST then use — rolling refresh without a refresh flow.",
        "Resource validates the signature and looks up the token in its own store."
      ],
      "is_response": false
    }
  ],
  "interactive": {
    "description": "The resource requires user interaction before granting access — for example, the user must log in via the resource's own OIDC provider. The agent initiates the request, is redirected to an interaction URL backed by OIDC/OAuth, polls while the user authenticates, then receives a session token. No PS or AS is involved at any point.",
    "participants": [
      {
        "id": "agent",
        "label": "Agent",
        "type": "agent"
      },
      {
        "id": "resource",
        "label": "Resource",
        "type": "resource"
      },
      {
        "id": "user",
        "label": "User",
        "type": "user"
      }
    ],
    "deferred_timeline": {
      "title": "Resource Interaction Polling",
      "events": [
        {
          "step": 1,
          "status": 202,
          "label": "Interaction required",
          "detail": "Resource returns pending URL and interaction URL backed by its OIDC provider."
        },
        {
          "step": 2,
          "status": 202,
          "label": "Polling — not yet approved",
          "detail": "User has not completed login. Agent keeps polling."
        },
        {
          "step": 4,
          "status": 202,
          "label": "Poll — interacting",
          "detail": "User has arrived at the resource's consent/login page; status=interacting. Agent stops prompting."
        },
        {
          "step": 5,
          "status": 200,
          "label": "Approved",
          "detail": "User authenticated via OIDC. Resource issues a session token."
        }
      ]
    },
