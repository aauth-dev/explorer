{
  "id": "resource-managed",
  "title": "Resource-Managed Access (2-party)",
  "description": "The resource manages authorization entirely itself — no PS or AS involved. It verifies the agent's signed request, applies its own policy (allowlist, pre-registered key, or internal rule), and issues a session token in the AAuth-Access header for subsequent calls. The session token is opaque to the agent — the resource wraps its own authorization state, which MAY be an existing OAuth access token — and it is the one AAuth credential a resource issues for its own consumption. A resource declares this mode as access_mode=session-token in its metadata.",
  "spec_section": "§ Resource-Managed Access (Two-Party)",
  "category": "access",
  "demo_phase": 2,
  "participants": [
    {
      "id": "agent",
      "label": "Agent",
      "type": "agent"
    },
    {
      "id": "resource",
      "label": "Resource",
      "type": "resource"
    }
  ],
  "steps": [
    {
      "step": 1,
      "from": "agent",
      "to": "resource",
      "label": "Signed GET /data → resource checks policy → 200 + session token",
      "method": "GET",
      "url": "https://api.example/data",
      "request_headers": {
        "Host": "api.example",
        "Signature-Key": "sig=jwt;jwt=\"eyJhbGciOiJFZERTQSIsImtpZCI6ImFnZW50LWtleS0xIiwidHlwIjoiYWEtYWdlbnQrand0In0…\"",
        "Signature-Input": "sig=(\"@method\" \"@authority\" \"@path\" \"signature-key\");created=1700000000;alg=\"ed25519\"",
        "Signature": "sig=:Hh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHg:"
      },
      "request_body": null,
      "response_status": 200,
      "response_headers": {
        "Content-Type": "application/json",
        "AAuth-Access": "rm-tok-a8f3c2e1b94d7065f2a1"
      },
      "response_body": {
        "message": "Access granted!",
        "agent": "aauth:local@agent.example"
      },
      "tokens": [
        {
          "name": "Agent Token",
          "typ": "aa-agent+jwt",
          "raw": "eyJhbGciOiJFZERTQSIsImtpZCI6ImFnZW50LWtleS0xIiwidHlwIjoiYWEtYWdlbnQrand0In0..8byvGd-PR3uOLeS_HYOpbW7OD_8whUuDRnadQOL83-3jp5V_zwPUkKvBZ-WmB26EaWGey4bVktpWtpykEOy_Bw",
          "header": {
            "alg": "EdDSA",
            "kid": "agent-key-1",
            "typ": "aa-agent+jwt"
          },
          "payload": {
            "iss": "https://agent.example",
            "dwk": "aauth-agent.json",
            "sub": "aauth:local@agent.example",
            "jti": "a6ae301d-1dc7-4b75-8f8b-5612197664a7",
            "cnf": {
              "jwk": {
                "kty": "OKP",
                "crv": "Ed25519",
                "x": "T_1-DXNIxIv0tFEqrD9q4LHu4VcHJgsiDPN__R1_Y2U",
                "kid": "agent-key-1"
              }
            },
            "iat": 1776222894,
            "exp": 1776226494
          },
          "signature_b64": "8byvGd-PR3uOLeS_HYOpbW7OD_8whUuDRnadQOL83-3jp5V_zwPUkKvBZ-WmB26EaWGey4bVktpWtpykEOy_Bw"
        }
      ],
      "signature": {
        "scheme": "jwt",
        "signature_base": "\"@method\": GET\n\"@authority\": api.example\n\"@path\": /data\n\"signature-key\": sig=jwt;jwt=\"eyJhbGciOiJFZERTQSIsImtpZCI6ImFnZW50LWtleS0xIiwidHlwIjoiYWEtYWdlbnQrand0In0…\"\n\"@signature-params\": (\"@method\" \"@authority\" \"@path\" \"signature-key\");created=1700000000;alg=\"ed25519\"",
        "signature_input": "sig=(\"@method\" \"@authority\" \"@path\" \"signature-key\");created=1700000000;alg=\"ed25519\"",
        "signature_key": "sig=jwt;jwt=\"eyJhbGciOiJFZERTQSIsImtpZCI6ImFnZW50LWtleS0xIiwidHlwIjoiYWEtYWdlbnQrand0In0…\"",
        "covered_components": [
          "@method",
          "@authority",
          "@path",
          "signature-key"
        ]
      },
      "annotations": [
        "Agent presents its agent token in the Signature-Key header using sig=jwt.",
        "Resource verifies the agent token JWT and HTTP signature, then checks its internal policy.",
        "This agent's domain is allowlisted — resource grants access immediately.",
        "Resource issues an AAuth-Access header carrying a session token for subsequent calls.",
        "The session token is a token68 string minted by the resource — not a JWT, no PS or AS. It names the continuing relationship the resource has established with this agent for this person."
      ],
      "is_response": false
    },
    {
