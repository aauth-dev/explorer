{
  "id": "clarification",
  "title": "Clarification Chat During Consent",
  "description": "During consent the person asks the agent a question about its stated justification. The PS delivers the question to the agent with 202 and requirement=clarification, the agent answers on the pending URL, and the person sees the answer as part of the consent context. The same requirement is used by an AS asking the PS.",
  "spec_section": "§ Clarification Chat",
  "category": "advanced",
  "demo_phase": 8,
  "participants": [
    {
      "id": "agent",
      "label": "Agent",
      "type": "agent"
    },
    {
      "id": "resource",
      "label": "Resource",
      "type": "resource"
    },
    {
      "id": "ps",
      "label": "Person Server",
      "type": "person-server"
    },
    {
      "id": "user",
      "label": "User",
      "type": "user"
    }
  ],
  "deferred_timeline": {
    "title": "Clarification & Consent Timeline",
    "events": [
      {
        "step": 2,
        "status": 202,
        "label": "Clarification required",
        "detail": "AS returns requirement=clarification; question is in the response body, not the header."
      },
      {
        "step": 3,
        "status": 202,
        "label": "Clarification answered",
        "detail": "Agent POSTs clarification_response; AS transitions to requirement=interaction for user consent."
      },
      {
        "step": 4,
        "status": 202,
        "label": "Poll — interacting",
        "detail": "User has arrived at the consent page (with clarification context); status=interacting."
      },
      {
        "step": 6,
        "status": 200,
        "label": "Auth token issued",
        "detail": "User approved; agent polls and receives the auth token."
      }
    ]
  },
  "steps": [
